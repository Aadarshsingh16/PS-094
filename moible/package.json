{
  "name": "sahayak-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell. Copies the web-app static export so mobile shows the same screens.",
  "scripts": {
    "sync": "npm run build --prefix ../web-app && npx cap sync",
    "sync:live": "CAP_SERVER_URL=http://127.0.0.1:3000 npx cap sync",
    "copy": "npx cap copy",
    "ios": "npx cap open ios",
    "android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5"
  }
}
